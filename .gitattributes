# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Code and configuration
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts & wrappers
*.sh text eol=lf
gradlew text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.so binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary

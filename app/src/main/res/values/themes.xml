<resources>
    <style name="Theme.KZVolume" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Global Inter Font -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- M3 Tokens -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnPrimaryContainer</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorCardBg</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>

        <item name="colorError">@color/colorWarning</item>
        <item name="colorOnError">#000000</item>
        <item name="colorOutline">@color/colorCardStroke</item>

        <!-- System UI -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Material3SettingsGroup shapes matching kzkt -->
    <style name="ShapeAppearance.KZVolume.GroupTop" parent="">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <style name="ShapeAppearance.KZVolume.GroupMiddle" parent="">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.KZVolume.GroupBottom" parent="">
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="ShapeAppearance.KZVolume.GroupSingle" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Material3.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
